# Copy this file to .env and fill in real values. .env is gitignored - never commit it.

# Multi-user app: each profile has its OWN spreadsheet and can optionally
# upload its OWN service account key from Settings -> Google Sheets sync -
# these two vars are only a SHARED FALLBACK for profiles that haven't
# configured their own, not the primary way to set this up anymore.
#
# Path to a DEDICATED service account JSON key (Sheets + Drive API scope
# only). Do NOT point this at a compute-default / broad-permission key.
# See docs/service_account_setup.md for how to create one.
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=

# Legacy, effectively dead on a fresh install: only ever read once, and only
# for the ONE profile an old single-user setup got upgraded under. A brand
# new install starts with just the `admin` profile (no financial data of its
# own) - leave this blank and configure each profile's spreadsheet from
# Settings -> Google Sheets sync instead, once you've created that profile.
GOOGLE_SPREADSHEET_ID=


# How often the background sync loop runs, in seconds.
SYNC_INTERVAL_SECONDS=45

# Host/port for the local web UI.
APP_HOST=127.0.0.1
APP_PORT=8000

# Optional HTTP Basic Auth for the web UI/API - off unless BOTH are set. Useful
# if you ever bind APP_HOST to something other than 127.0.0.1 (e.g. to reach it
# from your phone on the same network). The browser will prompt for these.
AUTH_USERNAME=
AUTH_PASSWORD=

# Directory holding .litertlm model files for local AI features (autocomplete,
# etc - see app/llm/). Leave blank to default to backend/models. Requires
# Python 3.10+ (see app/llm/router.py).
LITE_LLM_MODELS_DIR=

# "cpu" (default) or "gpu". GPU is a real speedup when it works, but was
# unreliable in past testing on this machine - engine creation can succeed
# while later inference calls fail outright. Opt-in: a failed GPU call
# retries once on CPU automatically and that model then stays on CPU for the
# rest of the process (see app/llm/router.py), so trying this is safe to
# experiment with - worst case, it silently behaves like "cpu" after the
# first failure. Benchmark it yourself first: scripts/bench_llm.py --backend gpu
LLM_BACKEND=cpu
