# Copy this file to .env and fill in real values. .env is gitignored - never commit it.

# Path to the DEDICATED service account JSON key (Sheets + Drive API scope only).
# Do NOT point this at a compute-default / broad-permission key.
# See docs/service_account_setup.md for how to create one.
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=

# The spreadsheet ID of the "Budget Tracker" sheet (from its URL). Leave blank
# on first run - the app will create a new spreadsheet and print the ID/URL
# to the console and the Logs page. Copy it here so restarts reuse the same
# sheet instead of creating a new one each time.
GOOGLE_SPREADSHEET_ID=

# Your Google account email - the service account shares the spreadsheet it
# creates with this address (Editor access) so it shows up in your own Drive.
OWNER_EMAIL=

# How often the background sync loop runs, in seconds.
SYNC_INTERVAL_SECONDS=45

# SQLite database file path (relative to the budget_tracker/ folder).
DB_PATH=data/budget_tracker.db

# Host/port for the local web UI.
APP_HOST=127.0.0.1
APP_PORT=8000

# Optional HTTP Basic Auth for the web UI/API - off unless BOTH are set. Useful
# if you ever bind APP_HOST to something other than 127.0.0.1 (e.g. to reach it
# from your phone on the same network). The browser will prompt for these.
AUTH_USERNAME=
AUTH_PASSWORD=

# Directory holding .litertlm model files for local AI features (autocomplete,
# etc - see app/llm/). Leave blank to default to backend/models. Requires
# Python 3.10+ (see app/llm/router.py).
LITE_LLM_MODELS_DIR=
